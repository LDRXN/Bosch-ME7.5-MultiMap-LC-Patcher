  <property name="styleSheet">
   <string>
QMainWindow, QWidget#centralWidget, QWidget#setupContent, QWidget#logContent {
    background: #f5f7fa; color: #20242a;
    font-family: "Segoe UI", "Inter", "DejaVu Sans", Arial;
    font-size: 10pt;
}
QWidget { color: #20242a; }
QLabel { background: transparent; border: none; }
QLabel#titleLabel { color: #3584e4; font-size: 24pt; font-weight: 800; }
QLabel#subtitleLabel { color: #7a818b; font-size: 8pt; font-weight: 700; }
QLabel#ecuBadgeLabel, QLabel#sizeBadgeLabel, QLabel#cutBadgeLabel {
    border-radius: 7px; padding: 5px 10px; font-size: 8.5pt; font-weight: 800;
}
QLabel#ecuBadgeLabel { color: #0969da; background: #eaf4ff; border: 1px solid #b6d8ff; }
QLabel#sizeBadgeLabel { color: #1a7f37; background: #eaf8ee; border: 1px solid #b7e2c2; }
QLabel#cutBadgeLabel { color: #b9382d; background: #fff0ed; border: 1px solid #efc0ba; }
QTabWidget::pane { border: none; }
QTabWidget::tab-bar { left: 0px; }
QTabBar::tab {
    background: transparent; color: #7a818b; border: none;
    border-bottom: 2px solid transparent; padding: 9px 15px; font-weight: 700;
    margin-right: 10px; margin-bottom: 6px;
}
QTabBar::tab:selected { color: #0969da; border-bottom: 2px solid #0969da; }
QTabBar::tab:hover { color: #0969da; background: #eaf4ff; }
QScrollArea { background: transparent; border: none; }
QFrame#fileFrame, QFrame#infoFrame, QFrame#logFrame {
    background: #ffffff; border: 1px solid #d9dee5; border-radius: 13px;
}
QFrame#lcFrame { background: #ffffff; border: 1px solid #cbdff0; border-radius: 13px; }
QLabel[role="sectionTitle"] { color: #20242a; font-size: 13pt; font-weight: 800; }
QLabel[role="muted"] { color: #7a818b; font-size: 8.7pt; }
QLabel[role="fieldLabel"] { color: #59636e; font-size: 9pt; font-weight: 700; }
QLabel[role="columnLabel"] { color: #0969da; font-size: 8.5pt; font-weight: 800; }
QLabel#mmStatusLabel { color: #0969da; font-size: 8.6pt; font-weight: 700; }
QLabel#selectionLabel { color: #0969da; font-size: 8.7pt; font-weight: 700; }
QLineEdit {
    min-height: 32px; color: #24292f; background: #f8fafc;
    border: 1px solid #d0d7de; border-radius: 7px; padding: 0 9px;
    selection-background-color: #54aeff;
}
QLineEdit:focus { background: #ffffff; border-color: #218bff; }
QLineEdit:disabled { color: #a1a8b0; background: #f4f5f7; border-color: #e3e7ec; }
QLineEdit[invalid="true"] { background: #fff7f5; border-color: #cf3b2e; }
QPushButton {
    min-height: 32px; color: #44515d; background: #ffffff;
    border: 1px solid #cfd5dc; border-radius: 7px;
    padding: 0 13px; font-weight: 700;
}
QPushButton:hover { background: #f0f6fc; border-color: #78b9ec; color: #075aab; }
QPushButton:pressed { background: #e3effb; }
QPushButton:focus { border-color: #218bff; }
QPushButton#browseBinButton, QPushButton#patchButton {
    color: #ffffff; background: #0969da; border-color: #0969da;
}
QPushButton#browseBinButton:hover, QPushButton#patchButton:hover { background: #0860ca; }
QPushButton#browseBinButton:pressed, QPushButton#patchButton:pressed { background: #0757ba; }
QPushButton#patchButton { min-height: 44px; border-radius: 9px; font-size: 10.5pt; padding: 0 22px; }
QPushButton[role="bank"] {
    color: #44515d; background: #f4f9fd; border-color: #c8dceb;
    padding: 0 12px; text-align: left;
}
QPushButton[role="bank"]:hover { background: #eaf5ff; border-color: #78b9ec; }
QPushButton[role="bank"]:checked { color: #ffffff; background: #0969da; border-color: #0969da; }
QPushButton:disabled, QPushButton[role="bank"]:disabled, QPushButton#patchButton:disabled,
QPushButton#browseBinButton:disabled {
    color: #9da3aa; background: #e8eaed; border-color: #d8dce1;
}
QLabel#lcDescriptionLabel {
    color: #59636e; background: #f6fbff; border: 1px solid #d5e7f5;
    border-radius: 8px; padding: 8px 11px; font-size: 8.8pt;
}
QLabel[role="ecuLabel"] { color: #7a818b; font-size: 8.4pt; }
QLabel[role="ecuValue"] { color: #20242a; font-size: 10pt; font-weight: 700; }
QPlainTextEdit {
    color: #344253; background: #f8fafc; border: 1px solid #e3e8ee;
    border-radius: 8px; padding: 8px; font-family: "DejaVu Sans Mono", Consolas, monospace;
    font-size: 8.8pt; selection-background-color: #b6d8ff;
}
QFrame#actionFrame { background: transparent; border: none; }
QFrame#resultFrame { background: #eaf8ee; border: 1px solid #b7e2c2; border-radius: 8px; }
QLabel#resultLabel { color: #1a7f37; font-size: 8.8pt; font-weight: 700; }
QProgressBar { min-height: 5px; max-height: 5px; background: #dce1e6; border: none; border-radius: 2px; }
QProgressBar::chunk { background: #218bff; border-radius: 2px; }
QFrame#footerFrame { background: transparent; border-top: 1px solid #d8dde3; }
QLabel#statusLabel { color: #59636e; font-size: 8.7pt; }
QLabel#stateLabel { color: #0969da; font-size: 8.7pt; font-weight: 800; }
QScrollBar:vertical { background: #edf0f4; width: 8px; border: none; margin: 0; }
QScrollBar::handle:vertical { background: #c4cdd8; min-height: 25px; border-radius: 4px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0px; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: none; }
QToolTip { background: #ffffff; color: #24292f; border: 1px solid #c9d0d7; padding: 6px; }
</string>
